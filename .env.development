# Vigicom - entorno de DESARROLLO
# Apunta a la base MySQL del contenedor compartido `herramientas-mysql`
# (stack `herramientas`), accesible desde los contenedores de Vigicom via
# host.docker.internal:3306.

APP_ENV=development

# Claves para firmar JWT por app. En dev son fijas (no usar en prod).
# Una key por app garantiza aislamiento: leak en una no compromete a las otras.
APP_KEY_CLOUD=dev-only-key-vigicom-cloud-do-not-use-in-prod
APP_KEY_APP=dev-only-key-vigicom-app-do-not-use-in-prod
APP_KEY_PANEL=dev-only-key-vigicom-panel-do-not-use-in-prod

DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=vigicom_dev
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Broker MQTT (EMQX) - servicio "emqx" del docker-compose
MQTT_HOST=emqx
MQTT_PORT=1883
MQTT_USER=d2s7M2q528gwS7xg
MQTT_PASS=rf412F576xWUgvLs
EMQX_DASHBOARD_PASS=rf412F576xWUgvLs
