# /etc/cron.d/vigicom-robot
# Tareas programadas del contenedor vigicom-robot.
#
# Formato: m h dom mon dow user command
# La ultima linea DEBE terminar con un salto de linea o cron la ignora.
#
# Para que el output de cada job aparezca en `docker compose logs robot`,
# redirigir a stdout/stderr de PID 1 (supervisord):
#   >> /proc/1/fd/1 2>> /proc/1/fd/2
#
# Despues de editar este archivo, hace rebuild para que tome efecto:
#   docker compose up -d --build robot

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Ejemplos (descomentar y ajustar al crontab real):
# * * * * * root php /var/www/robot/cronjobs/robot.php mod=alarmas_online >> /proc/1/fd/1 2>> /proc/1/fd/2
# */5 * * * * root php /var/www/robot/cronjobs/robot.php mod=facturas_autorizar >> /proc/1/fd/1 2>> /proc/1/fd/2
# 0 3 * * * root php /var/www/robot/cronjobs/contratosFacturar.php >> /proc/1/fd/1 2>> /proc/1/fd/2
