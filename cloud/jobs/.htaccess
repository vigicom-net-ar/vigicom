# Blindaje HTTP: la carpeta jobs/ es solo para invocación por CLI.
# Los scripts se disparan desde el scheduler (docker exec ... php <script>),
# nunca vía Apache.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
